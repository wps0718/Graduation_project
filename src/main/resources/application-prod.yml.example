# 生产环境配置模板
# 使用方法：复制此文件为 application-prod.yml，填入真实值（不要提交到 Git）
# 或通过环境变量注入（推荐）

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/secondhand?useSSL=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8&useUnicode=true
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      database: ${REDIS_DB:0}
      password: ${REDIS_PASSWORD:}

jwt:
  secret: ${JWT_SECRET}
  expiration: 86400000
  admin-expiration: 86400000

upload:
  path: ${UPLOAD_PATH:/var/uploads/secondhand/}

wx:
  appId: ${WX_APP_ID}
  appSecret: ${WX_APP_SECRET}
